{
    "label": "lock",
    "action": "playerctl -a pause && hyprctl dispatch exec hyprlock",
    "text": "Lock",
    "keybind": "l"
}

{
    "label": "suspend",
    "action": "systemctl suspend",
    "text": "Suspend",
    "keybind": "u"
}

{
    "label": "shutdown",
    "action": "systemctl poweroff",
    "text": "Shutdown",
    "keybind": "s"
}

{
    "label": "reboot",
    "action": "systemctl reboot",
    "text": "Reboot",
    "keybind": "r"
}
