(defvar expanded false)
(include './modules/bar/left_widgets.yuck')
(include './modules/bar/right_widgets.yuck')

(defwidget bar []
    (centerbox :orientation "h"
        (left_bar)
        (workspaces)
        (right_bar)
    )
)

(defwidget left_bar [] 
    (box :class "left_bar"
        :orientation "h"
        :halign "start"
        :space-evenly false 
        :spacing 40
        (window)
        (compo_temp)
        (ram)
        (cpu)
        (disk)
        (music)
    )
)

(defwidget right_bar [] 
    (box :class "right_bar" 
        :orientation "h" 
        :halign "end"
        :space-evenly false
        :spacing 40
        (updates)
        (lang)
        (volume)
        (brightness)
        (battery)
        (network)
        (bluetooth)
        (control_setting_icon)
        (time)
    )
)

(deflisten hyprland "./scripts/workspaces.sh")

(defwidget workspaces []
    (box 
        :class "workspaces"
        :halign "start"
        :spacing 10
        :orientation "h"
        :space-evenly false
        (for workspace in hyprland
            (eventbox
                :cursor "pointer"
                :onscroll "echo {} | sed -e 's/up/-1/g' -e 's/down/+1/g' | xargs hyprctl dispatch workspace"
                :halign "center"
                (button 
                    :class "${workspace.current ? "current" : ""} ${workspace.windows > 0 ? "occupied" : "empty"}"
                    :onclick "hyprctl dispatch workspace ${workspace.id}"
                    (button
                        :width 20
                        :class "icon ${workspace.current ? "current" : ""} ${workspace.windows > 0 ? "occupied" : "empty"}"
                        {workspace.current ? "" : ""}
                    )
                )
            )
        )
    )
)

(defwindow bar
    :monitor 0
    :exclusive "true"
    :geometry (geometry :x "0%"
        :y "0%"
        :width "100%"
        :height "3%"
        :anchor "top center")
    (bar)
)
