(defwindow wifi_password 
    :monitor 0
    :geometry (geometry 
               :x "5.7%"
                :y "1%"
                :width "350px"
                :height "200px"
                :anchor "top right")
    :stacking "overlay"
    :focusable true
    (password)
)

(defwidget password [] 
    (box
        :orientation "v"
        :class "password_popup"
        :space-evenly false
        :spacing 20
        (box 
            :orientation "h"
            :space-evenly false
            :spacing 20
            (image 
                :path "${icon_base}nm-signal-100-symbolic.svg"
                :width icon_size
                :height icon_size)
            (label 
                :class "password_title"
                :halign "start"
                :text "Enter Wifi password")
        )
        
        ;;TODO: For some reason I can not use wrap, gotta split this in half
        (box 
            :orientation "v"
            (label 
                :text "This WiFi is currently being secured"
                :class "password_title"
                :halign "start")

            (label 
                :text "Please enter its password to connect!"
                :class "password_title"
                :halign "start")
        )
        (input 
            :password true
            :timeout "3000ms"
            :class "password_input"
            :onaccept `bash ~/.config/eww/scripts/network/wifi_connect.sh '${ACTIVE_INPUT}' '{}' true false && disown`)

        (box 
            :orientation "h"
            :halign "end"
            :spacing 8
            (button 
                :onclick "eww close wifi_password"
                :class "cancel_button"
                "Cancel")
            (button 
                :onclick ""
                :class "ok_button"
                "Join")
        )
    )
)

